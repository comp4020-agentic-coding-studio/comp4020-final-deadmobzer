# What a remote build uploads from your working tree. CI checkouts carry none
# of this, so it only matters for a deploy run from your own machine; without
# it, node_modules and any local data ship to the builder.
.git
node_modules
dist
*.log

# The raw rulebook PDFs / art zips (~227 MB). We ship only the extracted assets
# under public/art and data/; never upload the source dump to the builder.
Magnagothica Maleghast/
.env
.env.*
.envrc
mise.local.toml
*.pem
.claude
