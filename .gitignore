node_modules/
dist/
*.log

# e2e/ (Playwright) run artifacts: videos, traces, HTML report — reviewable
# locally but not meant to be committed (see e2e/playwright.config.ts).
/e2e/test-results/
/e2e/playwright-report/
/playwright/.cache/

# built client bundle (produced by `pnpm build` from src/client/)
public/app.js

# Game source material: the full Magnagothica Maleghast rulebook PDFs, art zips,
# and design notes (~227 MB). We extract what we need (stats -> data/, art ->
# public/art/) and never commit the heavyweight originals. The author's work is
# credited in README.md.
Magnagothica Maleghast/

# editor and OS junk
.DS_Store
._*
Thumbs.db
Desktop.ini

# keep secrets out of the repo: your API key lives in an env var or an
# untracked file, never in a tracked one
.env
.env.*
.envrc
mise.local.toml
*.pem

# Claude Code's project directory is machine-local: settings in here can hold
# your course API key, and this repo goes public when you ship. Your tracked
# harness is CLAUDE.md (and any AGENTS.md), not this directory.
.claude/
